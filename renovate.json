{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>drevops/renovate-drupal"
  ],
  "enabledManagers": [
    "composer"
  ],
  "managerFilePatterns": [
  "/^composer\\.json$/"
  ],
  "composerIgnorePlatformReqs": [
    "php",
    "ext-*",
    "lib-*"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "rangeStrategy": "bump",
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "php"
      ],
      "enabled": false
    }
  ]
}
