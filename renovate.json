{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>drevops/renovate-drupal"
  ],
  "enabledManagers": ["composer"],
  "composerIgnorePlatformReqs": ["php", "ext-*", "lib-*"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "rangeStrategy": "update-lockfile",
  "automerge": false,
  "branchPrefix": "renovate/",
  "labels": ["dependencies"],
  "timezone": "Etc/UTC",
  "prHeader": "**Automated dependency update.** Please test on the dev site before merging and **check for configuration changes on production site.**",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "major": {
    "enabled": false
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "vendor/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["php"],
      "enabled": false
    },
    {
      "groupName": "Drupal core and contrib",
      "matchPackagePatterns": ["^drupal/"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "Drupal tooling",
      "matchPackagePatterns": ["^drush/|^phpstan/|^squizlabs/|^dealerdirect/"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}