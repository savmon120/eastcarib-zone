{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>drevops/renovate-drupal"
  ],
  "enabledManagers": ["composer"],
  "composerIgnorePlatformReqs": ["php", "ext-*", "lib-*"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "rangeStrategy": "bump"
}
