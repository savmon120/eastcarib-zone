<?php

/**
 * @file
 * Hook implementations for the Content filter module.
 */

use Drupal\content_filter\Hook\ContentFilterHooks;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_form_alter().
 *
 * @phpstan-ignore-next-line
 */
#[LegacyHook]
function content_filter_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  Drupal::service(ContentFilterHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_views_pre_view().
 *
 * @phpstan-ignore-next-line
 */
#[LegacyHook]
function content_filter_views_pre_view(ViewExecutable $view, $display_id, array $args): void {
  Drupal::service(ContentFilterHooks::class)->viewsPreView($view, $display_id, $args);
}

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * @phpstan-ignore-next-line
 */
#[LegacyHook]
function content_filter_menu_links_discovered_alter(array &$links): void {
  Drupal::service(ContentFilterHooks::class)->menuLinksDiscoveredAlter($links);
}
