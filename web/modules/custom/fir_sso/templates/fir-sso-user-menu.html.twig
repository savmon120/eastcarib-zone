<div class="vatsim-nav-item ms-auto d-flex align-items-center">
    {% if logged_in %}
        <div class="dropdown">
            <button class="vatsim-user-btn dropdown-toggle d-flex align-items-center gap-2" type="button" id="vatsimUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span>{{ user_name }}</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="vatsimUserDropdown">
                <li class="px-3 py-2 text-muted small border-bottom mb-1">
                    {{ cid }} &bull; {{ rating }}
                </li>
                <li><a class="dropdown-item" href="/profile">My Profile</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/user/logout">Log out</a></li>
            </ul>
        </div>
    {% else %}
        <a href="/vatsim/login" class="vatsim-login-btn">
            Log in with VATSIM
        </a>
    {% endif %}
    <button id="theme-toggle" class="theme-toggle-btn">
        <span class="theme-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24">
                <title xmlns="">sun-moon</title>
                <path fill="none" stroke="#1f2937" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m2.837 12.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715M16 12a4 4 0 0 0-4-4m7-3l-1.256 1.256M20 12h2"/>
            </svg>
        </span>
    </button>
</div>