<?php

/**
 * Implements hook_page_attachments().
 */
function ecz_vatsim_page_attachments(array &$attachments) {
    $config = \Drupal::config('ecz_vatsim.settings');

    $attachments['#attached']['drupalSettings']['eczVatsim'] = [
        'feedUrl' => $config->get('feed_url') ?: 'https://data.vatsim.net/v3/vatsim-data.json',
        'bookingsUrl' => $config->get('bookings_url') ?: '',
        'prefixes' => $config->get('prefixes') ?: 'TNCA, TNCB, TNCC, TNCM, TQPF, TNCS, TNCE, TNCF, TBPB, TFFF, TFFR, TAPA, TGPY, TVSA, TLPL, TDPD, TKPK, TTPP',
        'refreshRate' => $config->get('refresh_rate') ?: 60,
    ];
}
/**
 * Implements hook_cron().
 *
 * Events only need to be pulled once a day; the actual "has 24h passed"
 * check lives in EventsManager so it's reachable outside of a cron run too
 */
function ecz_vatsim_cron() {
  /** @var \Drupal\ecz_vatsim\EventsManager $events_manager */
  $events_manager = \Drupal::service('ecz_vatsim.events_manager');
  if ($events_manager->needsSync()) {
    $events_manager->sync();
  }
}

/**
 * Implements hook_theme().
 */
function ecz_vatsim_theme($existing, $type, $theme, $path) {
  return [
    'ecz_vatsim_events' => [
        'variables' => [
            'events' => [],
            'show_view_all' => FALSE,
            'view_all_url' => NULL,
        ],
        'path' => $path . '/templates',
        'template' => 'ecz-vatsim-events',
    ],
    'ecz_vatsim_events_page' => [
      'variables' => [
        'events' => [],
      ],
      'path' => $path . '/templates',
      'template' => 'ecz-vatsim-events-page',
    ],
  ];
}
use Drupal\user\Entity\User;

/**
 * Implements hook_preprocess_page().
 */
function ecz_vatsim_preprocess_page(&$variables) {
    $account = \Drupal::currentUser();
    if ($account->isAuthenticated()) {
        $user = User::load($account->id());

        if ($user->hasField('field_vatsim_cid') && !$user->get('field_vatsim_cid')->isEmpty()) {
            $cid = $user->get('field_vatsim_cid')->value;

            // Expose CID to JS
            $variables['#attached']['drupalSettings']['eczUser']['cid'] = $cid;
        }
    }
}

use Drupal\Core\Access\AccessResult;
use Drupal\node\NodeInterface;
use Drupal\Core\Session\AccountInterface;

function ecz_vatsim_node_access(NodeInterface $node, $op, AccountInterface $account) {
    // Replace 123 with your profile page node ID
    if ($node->bundle() === 'page' && $node->id() == 122) {
        if ($op === 'view') {
            return $account->hasRole('controller')
                ? AccessResult::allowed()
                : AccessResult::forbidden();
        }
    }

    return AccessResult::neutral();
}
