{#
/**
 * @file
 * Map tool page (/maptool): an interactive 3D map of the zone's airspace and
 * ATC positions. Sidebar controls on the left, the MapLibre map on the right.
 *
 * js/app.js fills in the chips, positions and legend, and draws the map.
 * Styles: css/maptool.css (scoped to .maptool).
 */
#}
<div class="maptool" data-maptool>
  <div id="app">
    <aside id="sidebar">
      <header class="side-head">
        <h1>Eastern Caribbean Zone</h1>
        <p class="sub">VATSIM / VATCAR · airspace &amp; ATC-position overview</p>
      </header>

      <div class="credit">
        <span class="credit-label">Made &amp; designed by</span>
        <a class="credit-name" href="mailto:d.peters@vatsim.net" title="Email d.peters@vatsim.net">Danny&nbsp;-| 963639 |-</a>
      </div>

      <section class="panel">
        <div class="panel-title">View</div>
        <div class="seg" id="dim-toggle">
          <button type="button" data-dim="3d" class="active">3D</button>
          <button type="button" data-dim="2d">2D flat</button>
        </div>
        <label class="ctl-row">
          <span>Basemap</span>
          <select id="basemap">
            <option value="dark">Dark</option>
            <option value="satellite">Satellite</option>
            <option value="light">Light</option>
          </select>
        </label>
        <label class="ctl-row slider">
          <span>Vertical exaggeration <b id="exag-val">12×</b></span>
          <input type="range" id="exag" min="1" max="40" step="1" value="12" />
        </label>
        <label class="ctl-row slider">
          <span>Airspace opacity <b id="op-val">50%</b></span>
          <input type="range" id="opacity" min="10" max="90" step="5" value="50" />
        </label>
      </section>

      <section class="panel">
        <div class="panel-title">Zones</div>
        <div id="groups" class="chips"></div>
      </section>

      <section class="panel">
        <div class="panel-title">Airspace types</div>
        <div id="types" class="chips"></div>
      </section>

      <section class="panel">
        <div class="panel-title">Controlling positions <span class="hint">click to isolate</span></div>
        <div id="positions" class="pos-list"></div>
      </section>

      <section class="panel legend">
        <div class="panel-title">Legend (by type)</div>
        <div id="legend" class="legend-grid"></div>
      </section>

      <footer class="side-foot">
        <div class="warn">Simulation reference only — not for real-world navigation.</div>
      </footer>
    </aside>

    <div id="map"></div>

    <div id="info" class="hidden">
      <button type="button" id="info-close" aria-label="close">×</button>
      <div id="info-body"></div>
    </div>
  </div>
</div>
