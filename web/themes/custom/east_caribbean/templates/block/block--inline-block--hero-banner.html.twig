<div class="custom-hero-banner">

    <div class="custom-hero-banner__bg">
        {{ content.field_background_image.0 }}
    </div>

    <div class="custom-hero-banner__content container">
        <div class="row">
            <div class="col-md-8 col-lg-6 text-start">
                {{ content.field_body }}
            </div>
        </div>
    </div>

    <div class="custom-hero-banner__wave">

        {# Light mode wave = first SVG #}
        {% if content.field_wave_graphic.1 %}
            <div class="wave-light">
                {{ content.field_wave_graphic.1 }}
            </div>
        {% endif %}

        {# Dark mode wave = second SVG #}
        {% if content.field_wave_graphic.0 %}
            <div class="wave-dark">
                {{ content.field_wave_graphic.0 }}
            </div>
        {% endif %}

    </div>

</div>